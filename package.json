{
  "name": "quoska",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Source-Zeiterfassung für kleine deutsche Betriebe",
  "homepage": "https://quoska.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quoska-hq/quoska.git"
  },
  "bugs": {
    "url": "https://github.com/quoska-hq/quoska/issues"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "setup": "make setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legal": "vitest run tests/legal/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "extension:build": "node scripts/build-browser-extension.mjs",
    "extension:build:local": "QUOSKA_EXTENSION_APP_URL=http://localhost:3000 node scripts/build-browser-extension.mjs",
    "search-console": "node scripts/search-console.mjs",
    "screenshots:marketing": "playwright test -c playwright.marketing.config.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.1.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.49.8",
    "@tanstack/react-query": "^5.76.1",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geoip-lite": "2.0.3",
    "lucide-react": "^1.17.0",
    "next": "^16.2.12",
    "react": "^19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.56.4",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "7.6.13",
    "@types/geoip-lite": "1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.12",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
