# Copy to /opt/quoska/.env.production on the server and set mode 600.
# Never commit the completed file.

# Deployment
QUOSKA_DOMAIN=quoska.de
QUOSKA_IMAGE=ghcr.io/oskarsync/quoska:replace-with-release-tag
NODE_ENV=production

# Supabase — create the project in the Frankfurt region
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
NEXT_PUBLIC_APP_URL=https://quoska.de
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=
# Optional public HTML-tag verification token. This must also be supplied as a
# Docker build argument because the marketing pages are statically generated.
GOOGLE_SITE_VERIFICATION=

# Scheduled jobs — generate with: openssl rand -hex 32
CRON_SECRET=replace-with-at-least-32-random-characters

# First-party, cookie-free website analytics (stored on this server)
ANALYTICS_DB_PATH=/app/data/site-analytics.sqlite
ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_ADMIN_EMAILS=owner@example.com

# Stripe — optional. Current tier IDs are required for paid checkout; Founder
# and legacy mappings are required only for the limited launch offer/old plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEAM_PRICE_ID=
STRIPE_TEAM_LEGACY_PRICE_IDS=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_BUSINESS_LEGACY_PRICE_IDS=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_LEGACY_PRICE_IDS=
STRIPE_TEAM_FOUNDER_PROMOTION_CODE_ID=
STRIPE_BUSINESS_FOUNDER_PROMOTION_CODE_ID=
STRIPE_PRO_FOUNDER_PROMOTION_CODE_ID=

# Reserved for transactional email integration
RESEND_API_KEY=
