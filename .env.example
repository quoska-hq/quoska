# ─── Database ───
# Supabase (EU region — Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth ───
# Supabase Auth handles this, but you may need:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "true" once Google OAuth is configured on your (hosted) Supabase project.
# Requires a public HTTPS URL — does NOT work against local supabase start.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=

# ─── Browser extension ───
# Required in production before extension connection is enabled. Comma-separated
# Chrome/Edge extension IDs; development accepts valid unpacked-extension IDs.
BROWSER_EXTENSION_IDS=

# ─── Payments ───
# Stripe — OPTIONAL. Leave all unset for the open-source / self-host build:
# the app runs fully on the free plan, billing UI is hidden, and webhook/
# checkout routes are inert. Set the secret, webhook secret, and current tier
# price IDs on the hosted/commercial build; add the Founder and legacy values
# when using the limited launch offer described below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Tiered flatrate — one recurring monthly price per tier (create in your Stripe dashboard):
STRIPE_TEAM_PRICE_ID=price_...        # €19/mo, ≤10 employees
STRIPE_BUSINESS_PRICE_ID=price_...    # €69/mo, ≤50 employees
STRIPE_PRO_PRICE_ID=price_...         # €129/mo, unlimited
# Keep prior price IDs here so grandfathered subscriptions continue to resolve
# correctly after the current tier Price IDs are replaced. Comma-separated.
STRIPE_TEAM_LEGACY_PRICE_IDS=
STRIPE_BUSINESS_LEGACY_PRICE_IDS=
STRIPE_PRO_LEGACY_PRICE_IDS=
# Promotion codes backed by forever coupons with max_redemptions=100 and
# first_time_transaction=true. Discounts: Team €10, Business €10, Pro €30.
STRIPE_TEAM_FOUNDER_PROMOTION_CODE_ID=promo_...
STRIPE_BUSINESS_FOUNDER_PROMOTION_CODE_ID=promo_...
STRIPE_PRO_FOUNDER_PROMOTION_CODE_ID=promo_...

# ─── Email ───
# Resend (transactional emails)
RESEND_API_KEY=re_...

# ─── Scheduled jobs ───
# Required for /api/v1/cron/* in every environment. Generate with:
# openssl rand -hex 32
CRON_SECRET=replace-with-at-least-32-random-characters

# ─── First-party website analytics ───
# Optional. If configured, pageviews are stored in a local SQLite volume.
ANALYTICS_DB_PATH=/tmp/quoska-site-analytics.sqlite
ANALYTICS_HASH_SECRET=replace-with-at-least-32-random-characters
ANALYTICS_ADMIN_EMAILS=owner@example.com

# ─── Environment ───
# Optional public token for Google Search Console's HTML-tag verification.
# Domain-property DNS verification does not use this value.
GOOGLE_SITE_VERIFICATION=
NODE_ENV=development
